@* Panel principal de la aplicación. Muestra los accesos a los distintos módulos del sistema. *@
@page "/dashboard/{UserName}"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS
 
<PageTitle>Vitta - Panel principal</PageTitle>
 
<div class="vitta-header">
    <span class="vitta-header-title">Vitta</span>
</div>
 
<div class="vitta-content">
 
    <h1 class="vitta-dashboard-h1">Bienvenido a nuestro sistema</h1>
    <p class="vitta-dashboard-sub">
        Desde aquí puedes acceder a los módulos principales de Vitta para gestionar tu información.
    </p>
 
    <div class="vitta-card vitta-modules-panel">
        <h2 class="vitta-modules-title">Módulos del sistema</h2>
 
        <div class="vitta-modules-grid">
            <button type="button" class="vitta-module-btn" @onclick="GoToProfile">
                Mi perfil
            </button>
 
            <button type="button" class="vitta-module-btn" @onclick="GoToMenuRegister">
                Registrar menú
            </button>
 
            <button type="button" class="vitta-module-btn" @onclick="GoToFoodConsult">
                Consultar alimentos
            </button>
 
            <button type="button" class="vitta-module-btn" @onclick="GoToNutritionInfo">
                Información nutricional
            </button>
 
            <button type="button" class="vitta-module-btn" @onclick="GoToStatistics">
                Estadísticas nutricionales
            </button>
        </div>
    </div>
 
    <div class="vitta-logout-row">
        <button type="button" class="vitta-btn-secondary vitta-logout-btn" @onclick="Logout">
            Cerrar sesión
        </button>
    </div>
 
</div>
 
@code {
    /// <summary>
    /// Obtiene o establece el nombre del usuario autenticado, recibido como parámetro de la ruta.
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = string.Empty;
 
    /// <summary>
    /// Redirige a la vista de perfil del usuario actual.
    /// </summary>
    private void GoToProfile()
    {
        Navigation.NavigateTo($"/perfil/{UserName}");
    }
 
    /// <summary>
    /// Redirige a la vista de consulta de alimentos.
    /// </summary>
    private void GoToFoodConsult()
    {
        Navigation.NavigateTo($"/consultar-alimentos/{UserName}");
    }
 
    /// <summary>
    /// Redirige a la vista de registro de menús del usuario actual.
    /// </summary>
    private void GoToMenuRegister()
    {
        Navigation.NavigateTo($"/registrar-menu/{UserName}");
    }
 
    /// <summary>
    /// Redirige a la vista de información nutricional del usuario actual.
    /// </summary>
    private void GoToNutritionInfo()
    {
        Navigation.NavigateTo($"/informacion-nutricional/{UserName}");
    }
 
    /// <summary>
    /// Redirige a la vista de estadísticas nutricionales del usuario actual.
    /// </summary>
    private void GoToStatistics()
    {
        Navigation.NavigateTo($"/estadisticas/{UserName}");
    }
 
    /// <summary>
    /// Solicita confirmación al usuario y, si acepta, cierra la sesión actual y regresa a la pantalla de inicio de sesión.
    /// </summary>
    private async Task Logout()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "¿Deseas cerrar la sesión actual?");
 
        if (confirmed)
        {
            Navigation.NavigateTo("/login");
        }
    }
}

 