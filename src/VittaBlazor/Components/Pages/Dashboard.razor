@page "/dashboard/{UserName}"
@rendermode InteractiveServer
@using VittaController
@using VittaModel
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserController UserController

<PageTitle>Vitta - Panel principal</PageTitle>

<div class="dash-header">
    <div class="dash-header-inner">
        <div class="dash-brand">
            <span class="dash-brand-circle">V</span>
            <span class="dash-brand-text">@(IsAdmin ? "Vitta - Admin" : "Vitta")</span>
        </div>
        <div class="dash-user-pill">
            <span class="dash-user-icon">@(IsAdmin ? "🛠️" : "👤")</span>
            <span class="dash-user-name">@UserName</span>
        </div>
    </div>
</div>

<div class="dash-content">

    <section class="dash-hero">
        <h1 class="dash-hero-title">
            @(IsAdmin ? "Panel de administración" : "Bienvenido a nuestro sistema")
        </h1>
        <p class="dash-hero-sub">
            @(IsAdmin
                ? "Gestiona los alimentos, los usuarios y las estadísticas globales del sistema."
                : "Desde aquí puedes acceder a los módulos principales de Vitta para gestionar tu información nutricional.")
        </p>
    </section>

    <section class="dash-modules-card">
        <h2 class="dash-modules-title">Módulos del sistema</h2>
        <p class="dash-modules-sub">Selecciona un módulo para comenzar</p>

        <div class="dash-grid">

            @if (IsAdmin)
            {
                <button type="button" class="dash-tile" @onclick="GoToProfile">
                    <div class="dash-tile-icon">👤</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Mi perfil</span>
                        <span class="dash-tile-desc">Consulta y actualiza tus datos</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToFoodAdmin">
                    <div class="dash-tile-icon">🍎</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Administrar alimentos</span>
                        <span class="dash-tile-desc">Crear, editar y eliminar alimentos</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToAdminUsers">
                    <div class="dash-tile-icon">👥</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Administrar usuarios</span>
                        <span class="dash-tile-desc">Registrar, resetear, cambiar tipo y desactivar usuarios</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToAdminStatistics">
                    <div class="dash-tile-icon">📊</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Estadísticas globales</span>
                        <span class="dash-tile-desc">Consulta el comportamiento general del sistema</span>
                    </div>
                </button>
            }
            else
            {
                <button type="button" class="dash-tile" @onclick="GoToProfile">
                    <div class="dash-tile-icon">👤</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Mi perfil</span>
                        <span class="dash-tile-desc">Consulta y actualiza tus datos</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToMenuRegister">
                    <div class="dash-tile-icon">📋</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Registrar menú</span>
                        <span class="dash-tile-desc">Anota tus comidas del día</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToFoodView">
                    <div class="dash-tile-icon">🍎</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Consultar alimentos</span>
                        <span class="dash-tile-desc">Busca alimentos disponibles</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToNutritionInfo">
                    <div class="dash-tile-icon">📊</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Información nutricional</span>
                        <span class="dash-tile-desc">IMC, calorías y macros</span>
                    </div>
                </button>

                <button type="button" class="dash-tile" @onclick="GoToStatistics">
                    <div class="dash-tile-icon">📈</div>
                    <div class="dash-tile-text">
                        <span class="dash-tile-title">Estadísticas nutricionales</span>
                        <span class="dash-tile-desc">Tu progreso diario y por rango</span>
                    </div>
                </button>
            }

        </div>
    </section>

    <div class="dash-logout-row">
        <button type="button" class="dash-logout-btn" @onclick="Logout">
            Cerrar sesión
        </button>
    </div>

</div>

@code {
    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private User? currentUser;

    private bool IsAdmin => this.currentUser?.IsAdmin ?? false;

    protected override async Task OnInitializedAsync()
    {
        this.currentUser = this.UserController.GetUserByUserName(this.UserName);

        if (this.currentUser is null)
        {
            await this.JS.InvokeVoidAsync("alert", "No se pudo cargar la sesión del usuario.");
            this.Navigation.NavigateTo("/login");
        }
    }

    private void GoToProfile()
    {
        this.Navigation.NavigateTo($"/perfil/{this.UserName}");
    }

    private void GoToFoodAdmin()
    {
        this.Navigation.NavigateTo($"/admin/alimentos/{this.UserName}");
    }

    private void GoToAdminUsers()
    {
        this.Navigation.NavigateTo($"/admin/usuarios/{this.UserName}");
    }

    private void GoToAdminStatistics()
    {
        this.Navigation.NavigateTo($"/admin/estadisticas/{this.UserName}");
    }

    private void GoToFoodView()
    {
        this.Navigation.NavigateTo($"/alimentos/{this.UserName}");
    }

    private void GoToMenuRegister()
    {
        this.Navigation.NavigateTo($"/registrar-menu/{this.UserName}");
    }

    private void GoToNutritionInfo()
    {
        this.Navigation.NavigateTo($"/informacion-nutricional/{this.UserName}");
    }

    private void GoToStatistics()
    {
        this.Navigation.NavigateTo($"/estadisticas/{this.UserName}");
    }

    private async Task Logout()
    {
        bool confirmed = await this.JS.InvokeAsync<bool>("confirm", "¿Deseas cerrar la sesión actual?");

        if (confirmed)
        {
            this.Navigation.NavigateTo("/login");
        }
    }
}