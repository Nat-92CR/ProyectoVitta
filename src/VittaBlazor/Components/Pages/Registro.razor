@page "/registro"
@rendermode InteractiveServer
@using VittaController
@using VittaModel
@inject LoginController LoginController
@inject NavigationManager Navigation

@*
    Presenta la vista de registro de usuario.
    Permite capturar la información principal requerida por el sistema
    y ejecutar el proceso de registro.
*@

<PageTitle>Registro</PageTitle>

<div class="vitta-auth-page">
    <div class="vitta-auth-card" style="max-width: 780px;">
        <div class="vitta-brand-circle">Vitta</div>

        <h1 class="vitta-auth-title">Registro de usuario</h1>
        <p class="vitta-auth-subtitle">
            Crea una cuenta para registrar alimentos, menús y consultar tu progreso nutricional.
        </p>

        <div class="vitta-form">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Usuario</label>
                        <input @bind="userName" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Contraseña</label>
                        <input type="password" @bind="password" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Nombre</label>
                        <input @bind="name" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Peso</label>
                        <input type="number" step="0.01" @bind="weight" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Altura</label>
                        <input type="number" step="0.01" @bind="height" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Edad</label>
                        <input type="number" @bind="age" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Sexo</label>
                        <select @bind="sex">
                            <option value="">Seleccione una opción</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                            <option value="No especificado">No especificado</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Objetivo</label>
                        <select @bind="goal">
                            <option value="">Seleccione una opción</option>
                            <option value="Mantener">Mantener</option>
                            <option value="Perder grasa">Perder grasa</option>
                            <option value="Ganar masa">Ganar masa</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Nivel de actividad</label>
                        <select @bind="activityLevel">
                            <option value="">Seleccione una opción</option>
                            <option value="Sedentario">Sedentario</option>
                            <option value="Ligero">Ligero</option>
                            <option value="Moderado">Moderado</option>
                            <option value="Alto">Alto</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="vitta-field">
                        <label>Tipo de dieta</label>
                        <select @bind="dietType">
                            <option value="">Seleccione una opción</option>
                            <option value="Estándar">Estándar</option>
                            <option value="Keto">Keto</option>
                            <option value="Vegetariana">Vegetariana</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="vitta-actions">
                <button type="button" class="vitta-btn" @onclick="HandleRegister">
                    Registrar
                </button>

                <button type="button" class="vitta-btn-secondary" @onclick="GoToLogin">
                    Cancelar
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="vitta-message">
                    @message
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string userName = string.Empty;
    private string password = string.Empty;
    private string name = string.Empty;
    private double weight;
    private double height;
    private int age;
    private string sex = string.Empty;
    private string goal = string.Empty;
    private string activityLevel = string.Empty;
    private string dietType = string.Empty;
    private string message = string.Empty;

    /// <summary>
    /// Ejecuta el proceso de registro de un nuevo usuario.
    /// </summary>
    private void HandleRegister()
    {
        var user = new User(
            this.userName,
            this.password,
            this.name,
            this.weight,
            this.height,
            this.goal,
            this.activityLevel,
            this.dietType,
            this.age,
            this.sex);

        bool result = this.LoginController.Register(user);

        if (result)
        {
            this.message = "Usuario registrado correctamente.";
            this.Navigation.NavigateTo("/login");
            return;
        }

        this.message = "No se pudo registrar el usuario. Verifique los datos o si el nombre de usuario ya existe.";
    }

    /// <summary>
    /// Redirige al usuario a la vista de inicio de sesión.
    /// </summary>
    private void GoToLogin()
    {
        this.Navigation.NavigateTo("/login");
    }
}