@* Página de información nutricional del usuario. Fiel a NutritionInfoView de WinForms. *@
@page "/informacion-nutricional/{UserName}"
@rendermode InteractiveServer
@using System.Globalization
@using VittaController.Abstractions
@using VittaModel
@inject INutritionInfoController NutritionInfoController
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Vitta - Información nutricional</PageTitle>

<div class="ni-header">
    <div class="ni-header-inner">
        <div class="ni-brand">
            <span class="ni-brand-circle">V</span>
            <span class="ni-brand-text">Vitta</span>
        </div>
        <button type="button" class="ni-back-btn" @onclick="GoBack">← Volver</button>
    </div>
</div>

<div class="ni-content">
    <div class="ni-card">
        <h1 class="ni-title">Información nutricional</h1>
        <p class="ni-subtitle">
            Resumen calculado de tus datos personales y necesidades diarias.
        </p>

        @if (loaded)
        {
            <section class="ni-section">
                <h2 class="ni-section-title">Datos personales</h2>
                <div class="ni-grid">
                    <div class="ni-field">
                        <label>Usuario</label>
                        <input value="@userName" readonly />
                    </div>
                    <div class="ni-field">
                        <label>Peso</label>
                        <input value="@weight" readonly />
                    </div>
                    <div class="ni-field">
                        <label>Altura</label>
                        <input value="@height" readonly />
                    </div>
                    <div class="ni-field">
                        <label>Objetivo</label>
                        <input value="@goal" readonly />
                    </div>
                    <div class="ni-field">
                        <label>Nivel de actividad</label>
                        <input value="@activityLevel" readonly />
                    </div>
                    <div class="ni-field">
                        <label>Tipo de dieta</label>
                        <input value="@dietType" readonly />
                    </div>
                </div>
            </section>

            <section class="ni-section">
                <h2 class="ni-section-title">Indicadores</h2>
                <div class="ni-stats-grid">
                    <div class="ni-stat-card">
                        <div class="ni-stat-icon">🔥</div>
                        <div class="ni-stat-text">
                            <span class="ni-stat-label">Calorías de mantenimiento</span>
                            <span class="ni-stat-value">@maintenanceCalories <span class="ni-stat-unit">kcal</span></span>
                        </div>
                    </div>
                    <div class="ni-stat-card">
                        <div class="ni-stat-icon">⚖️</div>
                        <div class="ni-stat-text">
                            <span class="ni-stat-label">Índice de masa corporal</span>
                            <span class="ni-stat-value">@bodyMassIndex</span>
                            <span class="ni-stat-extra">@bodyMassIndexCategory</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="ni-section">
                <h2 class="ni-section-title">Distribución diaria de macronutrientes</h2>
                <div class="ni-stats-grid">
                    <div class="ni-stat-card ni-protein">
                        <div class="ni-stat-icon">🥩</div>
                        <div class="ni-stat-text">
                            <span class="ni-stat-label">Proteínas</span>
                            <span class="ni-stat-value">@proteinGrams <span class="ni-stat-unit">g</span></span>
                        </div>
                    </div>
                    <div class="ni-stat-card ni-carbs">
                        <div class="ni-stat-icon">🌾</div>
                        <div class="ni-stat-text">
                            <span class="ni-stat-label">Carbohidratos</span>
                            <span class="ni-stat-value">@carbohydratesGrams <span class="ni-stat-unit">g</span></span>
                        </div>
                    </div>
                    <div class="ni-stat-card ni-fat">
                        <div class="ni-stat-icon">🥑</div>
                        <div class="ni-stat-text">
                            <span class="ni-stat-label">Grasas</span>
                            <span class="ni-stat-value">@fatGrams <span class="ni-stat-unit">g</span></span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="ni-actions">
                <button type="button" class="ni-btn-secondary" @onclick="GoBack">Cerrar</button>
            </div>
        }
        else
        {
            <p class="ni-empty">No se pudo cargar la información del usuario.</p>
        }
    </div>
</div>

@code {
    private string userName = string.Empty;
    private User? currentUser;

    private double bodyMassIndex;
    private string bmiStatus = string.Empty;
    private double maintenanceCalories;
    private double recommendedCalories;
    private string generalRecommendation = string.Empty;

    private double proteinPercentage;
    private double carbohydratesPercentage;
    private double fatPercentage;

    private double proteinGrams;
    private double carbohydratesGrams;
    private double fatGrams;

    /// <summary>
    /// Obtiene el nombre de usuario desde la URL y carga sus datos nutricionales.
    /// </summary>
    protected override void OnInitialized()
    {
        Uri uri = this.NavigationManager.ToAbsoluteUri(this.NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("username", out var usernameValue))
        {
            this.userName = usernameValue.ToString();
            this.currentUser = this.LoginController.GetUserByUserName(this.userName);
        }

        if (this.currentUser is not null)
        {
            this.CalculateNutritionData();
        }
    }

    /// <summary>
    /// Calcula los principales indicadores nutricionales del usuario.
    /// </summary>
    private void CalculateNutritionData()
    {
        this.bodyMassIndex = this.CalculateBodyMassIndex();
        this.bmiStatus = this.GetBmiStatus();
        this.maintenanceCalories = this.CalculateMaintenanceCalories();
        this.recommendedCalories = this.CalculateRecommendedCalories();
        this.SetMacronutrientDistribution();
        this.CalculateMacronutrientGrams();
        this.generalRecommendation = this.BuildGeneralRecommendation();
    }

    /// <summary>
    /// Calcula el índice de masa corporal del usuario.
    /// </summary>
    /// <returns>Valor de IMC calculado.</returns>
    private double CalculateBodyMassIndex()
    {
        if (this.currentUser is null || this.currentUser.Height <= 0)
        {
            return 0;
        }

        double heightInMeters = this.currentUser.Height / 100.0;
        return this.currentUser.Weight / (heightInMeters * heightInMeters);
    }

    /// <summary>
    /// Obtiene la clasificación del IMC calculado.
    /// </summary>
    /// <returns>Texto descriptivo del estado del IMC.</returns>
    private string GetBmiStatus()
    {
        if (this.bodyMassIndex <= 0)
        {
            return "Sin cálculo";
        }

        if (this.bodyMassIndex < 18.5)
        {
            return "Bajo peso";
        }

        if (this.bodyMassIndex < 25)
        {
            return "Normal";
        }

        if (this.bodyMassIndex < 30)
        {
            return "Sobrepeso";
        }

        return "Obesidad";
    }

    /// <summary>
    /// Calcula las calorías de mantenimiento del usuario.
    /// </summary>
    /// <returns>Calorías aproximadas de mantenimiento.</returns>
    private double CalculateMaintenanceCalories()
    {
        if (this.currentUser is null)
        {
            return 0;
        }

        double baseCalories;

        if (this.currentUser.Sex == "Masculino")
        {
            baseCalories = 10 * this.currentUser.Weight
                + 6.25 * this.currentUser.Height
                - 5 * this.currentUser.Age
                + 5;
        }
        else
        {
            baseCalories = 10 * this.currentUser.Weight
                + 6.25 * this.currentUser.Height
                - 5 * this.currentUser.Age
                - 161;
        }

        return baseCalories * this.GetActivityFactor();
    }

    /// <summary>
    /// Obtiene el factor de actividad según el nivel registrado.
    /// </summary>
    /// <returns>Factor multiplicador de actividad.</returns>
    private double GetActivityFactor()
    {
        if (this.currentUser is null)
        {
            return 1.2;
        }

        switch (this.currentUser.ActivityLevel)
        {
            case "Sedentario":
                return 1.2;
            case "Ligero":
                return 1.375;
            case "Moderado":
                return 1.55;
            case "Activo":
                return 1.725;
            default:
                return 1.2;
        }
    }

    /// <summary>
    /// Calcula las calorías recomendadas según el objetivo del usuario.
    /// </summary>
    /// <returns>Calorías recomendadas diarias.</returns>
    private double CalculateRecommendedCalories()
    {
        if (this.currentUser is null)
        {
            return 0;
        }

        if (this.currentUser.Goal == "Perder peso")
        {
            return this.maintenanceCalories - 300;
        }

        if (this.currentUser.Goal == "Ganar masa muscular")
        {
            return this.maintenanceCalories + 300;
        }

        return this.maintenanceCalories;
    }

    /// <summary>
    /// Define la distribución porcentual de macronutrientes según el tipo de dieta.
    /// </summary>
    private void SetMacronutrientDistribution()
    {
        if (this.currentUser is null)
        {
            this.proteinPercentage = 25;
            this.carbohydratesPercentage = 50;
            this.fatPercentage = 25;
            return;
        }

        switch (this.currentUser.DietType)
        {
            case "Alta en proteína":
                this.proteinPercentage = 30;
                this.carbohydratesPercentage = 40;
                this.fatPercentage = 30;
                break;

            case "Vegetariana":
                this.proteinPercentage = 20;
                this.carbohydratesPercentage = 50;
                this.fatPercentage = 30;
                break;

            case "Vegana":
                this.proteinPercentage = 20;
                this.carbohydratesPercentage = 55;
                this.fatPercentage = 25;
                break;

            default:
                this.proteinPercentage = 25;
                this.carbohydratesPercentage = 50;
                this.fatPercentage = 25;
                break;
        }
    }

    /// <summary>
    /// Calcula los gramos de macronutrientes según las calorías recomendadas.
    /// </summary>
    private void CalculateMacronutrientGrams()
    {
        this.proteinGrams = (this.recommendedCalories * (this.proteinPercentage / 100.0)) / 4.0;
        this.carbohydratesGrams = (this.recommendedCalories * (this.carbohydratesPercentage / 100.0)) / 4.0;
        this.fatGrams = (this.recommendedCalories * (this.fatPercentage / 100.0)) / 9.0;
    }

    /// <summary>
    /// Construye una recomendación general según el objetivo nutricional.
    /// </summary>
    /// <returns>Texto de recomendación general.</returns>
    private string BuildGeneralRecommendation()
    {
        if (this.currentUser is null)
        {
            return string.Empty;
        }

        if (this.currentUser.Goal == "Perder peso")
        {
            return "Se recomienda un ligero déficit calórico para favorecer la pérdida de peso.";
        }

        if (this.currentUser.Goal == "Ganar masa muscular")
        {
            return "Se recomienda un ligero superávit calórico para favorecer el aumento de masa muscular.";
        }

        return "Se recomienda mantener un consumo calórico equilibrado para conservar el estado actual.";
    }

    /// <summary>
    /// Nombre del usuario autenticado, recibido como parámetro de la ruta.
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private bool loaded;
    private string userName = string.Empty;
    private string weight = string.Empty;
    private string height = string.Empty;
    private string goal = string.Empty;
    private string activityLevel = string.Empty;
    private string dietType = string.Empty;
    private string maintenanceCalories = "0";
    private string bodyMassIndex = "0";
    private string bodyMassIndexCategory = string.Empty;
    private string proteinGrams = "0";
    private string carbohydratesGrams = "0";
    private string fatGrams = "0";

    /// <summary>
    /// Carga los datos del usuario y calcula la información nutricional al inicializar la página.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        User? user = this.NutritionInfoController.GetUserByUserName(this.UserName);

        if (user is null)
        {
            await this.JS.InvokeVoidAsync("alert", "No se pudo cargar la información del usuario.");
            this.Navigation.NavigateTo($"/dashboard/{this.UserName}");
            return;
        }

        this.userName = user.UserName;
        this.weight = user.Weight.ToString("0.##", CultureInfo.InvariantCulture);
        this.height = user.Height.ToString("0.##", CultureInfo.InvariantCulture);
        this.goal = user.Goal;
        this.activityLevel = user.ActivityLevel;
        this.dietType = user.DietType;

        double maintenance = this.NutritionInfoController.CalculateMaintenanceCalories(user);
        this.maintenanceCalories = maintenance.ToString("0.##", CultureInfo.InvariantCulture);

        double bmi = this.NutritionInfoController.CalculateBodyMassIndex(user);
        this.bodyMassIndex = bmi.ToString("0.##", CultureInfo.InvariantCulture);
        this.bodyMassIndexCategory = this.NutritionInfoController.GetBodyMassIndexCategory(bmi);

        this.NutritionInfoController.CalculateMacronutrients(
            user,
            out double proteinG,
            out double carbsG,
            out double fatG);

        this.proteinGrams = proteinG.ToString("0.##", CultureInfo.InvariantCulture);
        this.carbohydratesGrams = carbsG.ToString("0.##", CultureInfo.InvariantCulture);
        this.fatGrams = fatG.ToString("0.##", CultureInfo.InvariantCulture);

        this.loaded = true;
    }

    /// <summary>
    /// Regresa al dashboard del usuario actual.
    /// </summary>
    private void GoBack()
    {
        this.Navigation.NavigateTo($"/dashboard/{this.UserName}");
    }
}