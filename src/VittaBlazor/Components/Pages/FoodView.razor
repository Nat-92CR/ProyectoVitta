@* Página de consulta de alimentos en modo solo lectura. Para usuarios regulares. *@
@page "/alimentos/{UserName}"
@rendermode InteractiveServer
@using VittaController.Abstractions
@using VittaModel
@inject IFoodController FoodController
@inject NavigationManager Navigation

<PageTitle>Vitta - Consultar alimentos</PageTitle>

<div class="fv-header">
    <div class="fv-header-inner">
        <div class="fv-brand">
            <span class="fv-brand-circle">V</span>
            <span class="fv-brand-text">Vitta</span>
        </div>
        <button type="button" class="fv-back-btn" @onclick="GoBack">← Volver</button>
    </div>
</div>

<div class="fv-content">
    <div class="fv-card">
        <h1 class="fv-title">Consultar alimentos</h1>
        <p class="fv-subtitle">
            Busca alimentos disponibles en el sistema y consulta su información nutricional.
        </p>

        <div class="fv-search-row">
            <input class="fv-search-input" placeholder="Buscar alimento por nombre..." @bind="searchText" />
            <button type="button" class="fv-btn-primary" @onclick="SearchFoods">Buscar</button>
            <button type="button" class="fv-btn-secondary" @onclick="ShowAll">Mostrar todos</button>
        </div>

        <div class="fv-table-wrapper">
            <table class="fv-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Calorías</th>
                        <th>Proteínas</th>
                        <th>Carbohidratos</th>
                        <th>Grasas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (foods is null || foods.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="fv-empty">No se encontraron alimentos.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var food in foods)
                        {
                            <tr>
                                <td>@food.Name</td>
                                <td>@food.Calories</td>
                                <td>@food.Protein</td>
                                <td>@food.Carbohydrates</td>
                                <td>@food.Fat</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="fv-info-box">
            <span class="fv-info-icon">ℹ️</span>
            <span class="fv-info-text">
                Solo el administrador puede crear, editar o eliminar alimentos.
                Si necesitas que se agregue un alimento, contáctalo.
            </span>
        </div>

    </div>
</div>

@code {
    /// <summary>
    /// Nombre del usuario autenticado, recibido como parámetro de la ruta.
    /// </summary>
    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private List<Food> foods = new();
    private string searchText = string.Empty;

    /// <summary>
    /// Carga la lista inicial de alimentos.
    /// </summary>
    protected override void OnInitialized()
    {
        this.foods = this.FoodController.GetFoods();
    }

    /// <summary>
    /// Busca alimentos por nombre.
    /// </summary>
    private void SearchFoods()
    {
        this.foods = this.FoodController.SearchFoodsByName(this.searchText ?? string.Empty);
    }

    /// <summary>
    /// Muestra todos los alimentos disponibles.
    /// </summary>
    private void ShowAll()
    {
        this.searchText = string.Empty;
        this.foods = this.FoodController.GetFoods();
    }

    /// <summary>
    /// Regresa al dashboard del usuario actual.
    /// </summary>
    private void GoBack()
    {
        this.Navigation.NavigateTo($"/dashboard/{this.UserName}");
    }
}