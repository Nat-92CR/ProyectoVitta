@page "/profile"
@rendermode InteractiveServer
@inject NavigationManager Navigation

@*
    Presenta la vista base del perfil del usuario.
    Permite dejar preparada la navegación desde el dashboard
    para continuar con la implementación del módulo.
*@

<PageTitle>Profile</PageTitle>

<div class="vitta-page-center">
    <div class="vitta-card" style="width: 100%; max-width: 760px;">
        <div class="vitta-brand-circle">Vitta</div>
        <h1 class="vitta-auth-title">Profile</h1>
        <p class="vitta-auth-subtitle">
            Esta vista queda lista para mostrar la información personalizada del usuario.
        </p>

        <div class="vitta-message">
            Aquí se mostrará la información del perfil y la edición de datos del usuario.
        </div>

        <div class="vitta-actions">
            <button type="button" class="vitta-btn-secondary" @onclick="GoToDashboard">Volver al dashboard</button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Redirige a la vista principal del dashboard.
    /// </summary>
    private void GoToDashboard()
    {
        this.Navigation.NavigateTo("/dashboard");
    }
}